{
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "extra": {
    "installer-paths": {
      "./app/public/wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ]
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*"
      ]
    }
  ],
  "require-dev": {
    "php-stubs/wordpress-seo-stubs": "^20.5.1",
    "wpackagist-plugin/debug-bar": "^1.1.8",
    "php-stubs/wordpress-stubs": "^6.9.4"
  },
  "require": {
    "wpackagist-plugin/duplicate-post": "^4.7",
    "wpackagist-plugin/favicon-by-realfavicongenerator": "^1.3.50",
    "wpackagist-plugin/imagify": "^2.3.3",
    "wpackagist-plugin/imsanity": "^2.9.4",
    "wpackagist-plugin/svg-support": "^2.6.1",
    "wpackagist-plugin/wordpress-seo": "^28.4",
    "wpackagist-plugin/wp-sweep": "^2.0.1"
  },
  "type": "project"
}
