{
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "extra": {
    "installer-paths": {
      "./app/public/wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ]
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*"
      ]
    }
  ],
  "require-dev": {
    "wpackagist-plugin/debug-bar": "^1.1.8",
    "php-stubs/wordpress-stubs": "^7.1"
  },
  "require": {
    "wpackagist-plugin/duplicate-post": "^4.7",
    "wpackagist-plugin/favicon-by-realfavicongenerator": "^1.3",
    "wpackagist-plugin/imagify": "^2.3",
    "wpackagist-plugin/imsanity": "^2.9",
    "wpackagist-plugin/svg-support": "^2.6",
    "wpackagist-plugin/wordpress-seo": "^28.5",
    "wpackagist-plugin/wp-sweep": "^2.0"
  },
  "type": "project"
}
