{
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "extra": {
    "installer-paths": {
      "./app/public/wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ]
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*"
      ]
    }
  ],
  "require-dev": {
    "php-stubs/wordpress-stubs": "^7.1.2",
    "wpackagist-plugin/debug-bar": "^1.2.0"
  },
  "require": {
    "wpackagist-plugin/duplicate-post": "^4.7",
    "wpackagist-plugin/favicon-by-realfavicongenerator": "^1.3.52",
    "wpackagist-plugin/imagify": "^2.3.5",
    "wpackagist-plugin/imsanity": "^2.9.4",
    "wpackagist-plugin/svg-support": "^2.6.4",
    "wpackagist-plugin/wordpress-seo": "^28.9",
    "wpackagist-plugin/wp-sweep": "^2.0.1"
  },
  "type": "project"
}
